{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research_tree.json",
  "type": "object",
  "required": ["title", "nodes"],
  "additionalProperties": true,
  "properties": {
    "title": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/definitions/node"}
    }
  },
  "definitions": {
    "review_surface": {
      "type": "object",
      "properties": {
        "reviewer": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["unreviewed", "reviewed", "approved", "rejected", "accepted", "weakened"]
        },
        "concerns": {"type": "string"}
      },
      "required": ["status"]
    },
    "node": {
      "type": "object",
      "required": ["id", "parent", "title", "status", "motivation", "action", "conclusion", "invalidation"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$"},
        "parent": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["active", "confirmed", "pruned", "noisy", "superseded", "partially_reusable"]
        },
        "time": {"type": "string"},
        "motivation": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "invalidation": {"type": "string", "minLength": 1},
        "layer": {
          "type": "string",
          "enum": ["phenomenon", "mechanism", "extension_axiom", "axiom", "theorem", "algorithm", "test", "parameter", "hypothesis"],
          "comment": "Ascent-descent layer. Optional for backward compatibility; when present, validate_tree.py enforces the layer contract."
        },
        "direction": {"type": "string", "enum": ["ascent", "descent"]},
        "axioms_used": {"type": "array", "items": {"type": "string"}, "comment": "theorem/algorithm: ids of axiom or extension_axiom nodes it depends on"},
        "implements": {"type": "array", "items": {"type": "string"}, "comment": "algorithm: ids of theorem nodes it implements"},
        "data_source": {"type": "string", "comment": "extension_axiom: dataset/version the law was induced from"},
        "holdout": {"type": "string", "comment": "extension_axiom: held-out test supporting it"},
        "validity_range": {"type": "string", "comment": "extension_axiom: where it is known not to apply"},
        "lean": {
          "type": "object",
          "properties": {
            "decl": {"type": "string"},
            "file": {"type": "string"},
            "status": {"type": "string", "enum": ["paper", "stated", "proved", "audited"]},
            "independence_witness": {"type": "string"},
            "consistency_model": {"type": "string"}
          }
        },
        "revises": {"type": "string", "comment": "axiom/extension_axiom: id of the node this one replaces"},
        "no_go": {
          "type": "object",
          "required": ["statement", "diagnosis_order"],
          "properties": {
            "statement": {"type": "string"},
            "evidence": {"type": "string"},
            "diagnosis_order": {"type": "array", "items": {"type": "string", "enum": ["algorithm", "extension_axiom", "derivation"]}}
          }
        },
        "confidence": {
          "type": "string",
          "enum": ["O", "K", "D", "A", "I", "M", "S"]
        },
        "theory_package": {
          "type": "object",
          "properties": {
            "core_theory": {"type": "string"},
            "auxiliary_assumptions": {"type": "string"},
            "implementation": {"type": "string"},
            "optimization": {"type": "string"},
            "measurement": {"type": "string"},
            "baseline_relation": {"type": "string"}
          }
        },
        "prediction": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "pattern": "^P-[0-9]{8}-[0-9]{2}$"},
            "registered_before_result": {"type": "boolean"},
            "expected_observation": {"type": "string"},
            "falsifying_observation": {"type": "string"}
          }
        },
        "false_win_checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "closed"],
            "properties": {
              "path": {"type": "string"},
              "closed": {"type": "boolean"},
              "evidence": {"type": "string"},
              "residual_risk": {"type": "string"}
            }
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "hypothesis_collaborator": {"$ref": "#/definitions/review_surface"},
            "experiment_approval_committee": {"$ref": "#/definitions/review_surface"},
            "conclusion_reviewer": {"$ref": "#/definitions/review_surface"}
          }
        },
        "pruning_record": {
          "type": "object",
          "comment": "validate_tree.py hard-requires reason/pruning_commit/recovery_note whenever status is pruned/noisy/superseded -- required here too so a schema-only consumer sees the same contract.",
          "required": ["reason", "pruning_commit", "recovery_note"],
          "properties": {
            "reason": {"type": "string"},
            "dependent_subtree": {"type": "array", "items": {"type": "string"}},
            "conclusions_no_longer_admissible": {"type": "string"},
            "measurements_still_valid": {"type": "string"},
            "replacement_branch": {"type": "string"},
            "pruning_commit": {"type": "string"},
            "recovery_note": {"type": "string"}
          }
        }
      }
    }
  }
}
